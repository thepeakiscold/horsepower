#!/bin/sh
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop horsepower.service >/dev/null || true
    else
        systemctl stop horsepower.service >/dev/null || true
    fi
fi

#DEBHELPER#
exit 0
